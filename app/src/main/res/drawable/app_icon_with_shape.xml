<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Фон с градиентом и закругленными углами -->
    <item android:drawable="@drawable/gradient_log" />
    <!-- Изображение поверх фона -->
    <item>
        <inset
            android:insetLeft="@dimen/fab_margin"
            android:insetRight="@dimen/fab_margin"
            android:insetTop="@dimen/fab_margin"
            android:insetBottom="@dimen/fab_margin">
        <bitmap
            android:src="@drawable/log"
            android:gravity="center" /> <!-- Центрируем изображение -->
        </inset>
    </item>
</layer-list>