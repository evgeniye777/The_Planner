<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.The_Planner_Semen" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/whiteStatus</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:navigationBarColor">@color/whiteStatus</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/whiteStatus</item>
        <!-- Customize your theme here. -->
        <item name="android:windowLightStatusBar">true</item>
     </style>

     <style name="Theme.The_Planner_Semen.NoActionBar">
         <item name="windowActionBar">false</item>
         <item name="windowNoTitle">true</item>
     </style>

     <style name="Theme.The_Planner_Semen.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

     <style name="Theme.The_Planner_Semen.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
 </resources>